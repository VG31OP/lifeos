# LifeOS Backend Configuration
# Copy this to .env and fill in your values

# Runtime mode for local Docker development. Production defaults to strict config validation.
APP_ENV=development

# Database
DATABASE_URL=postgresql+asyncpg://lifeos:lifeos@localhost:5432/lifeos

# JWT
# Set a real secret with at least 32 characters before running the app.
SECRET_KEY=change-me-to-a-secure-random-string-32-plus-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Nebius AI Cloud
# Development placeholder; replace with a valid key to test the AI integration.
NEBIUS_API_KEY=dev-nebius-api-key
NEBIUS_API_URL=https://api.studio.nebius.ai/v1

# NVIDIA Models (eligible open-source models)
NVIDIA_CHAT_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct
NVIDIA_EMBEDDING_MODEL=nvidia/NV-Embed-v2

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000