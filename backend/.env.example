# LifeOS Backend Configuration
# Copy this to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://lifeos:lifeos@localhost:5432/lifeos

# JWT
SECRET_KEY=replace-me-with-a-secure-random-string-32-plus-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Nebius AI Cloud
NEBIUS_API_KEY=your-nebius-api-key
NEBIUS_API_URL=https://api.studio.nebius.ai/v1

# NVIDIA Models (eligible open-source models)
NVIDIA_CHAT_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct
NVIDIA_EMBEDDING_MODEL=nvidia/NV-Embed-v2

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000